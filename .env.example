# Public (safe for the browser). Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON=your-anon-or-publishable-key
# Your site URL, used for email confirmation / password reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NOTE: the service-role key is intentionally NOT used by this codebase.
# Admin actions run through SECURITY DEFINER SQL functions guarded by the user_roles table.

# Real-time human audio (create a project at https://cloud.livekit.io/)
# Use the WebSocket URL shown by LiveKit, usually wss://<your-project>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
